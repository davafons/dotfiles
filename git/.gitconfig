[user]
  name = David Afonso
  email = davafons@gmail.com
  username = davafons
  signingkey = 09C635A88F755238

[core]
  editor = nvim

[diff]
  tool = vimdiff

[push]
  default = current

[alias]
  a = add --all
  ai = add -i

  l = log
  s = status
  b = branch
  bd = branch -d
  c = checkout

  uns = reset HEAD

  d = diff
  dc = diff --cached

  ret = "!git add . & git cz --retry"

  co = comit
  coa = commit --amend

[pull]
  rebase = true

[commit]
  # Disabled: GPG signing breaks non-interactive/agent commits (no pinentry TTY).
  # Re-enable with `git config --global commit.gpgsign true` when needed.
  gpgsign = false
[credential "https://github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/opt/homebrew/bin/gh auth git-credential
