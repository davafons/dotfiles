#!/usr/bin/env bash
# Drive the real Brave profile through the Playwright Extension (tab group, not
# CDP). Token + Brave path live in ~/.config/playwright-cli/env.
set -euo pipefail

allow_foreground=0
activity_option=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --allow-foreground)
      allow_foreground=1
      shift
      ;;
    --activity)
      if [[ $# -lt 2 ]]; then
        echo "playwright-cli: --activity requires a name" >&2
        exit 64
      fi
      activity_option="$2"
      shift 2
      ;;
    --activity=*)
      activity_option="${1#--activity=}"
      shift
      ;;
    *) break ;;
  esac
done

ENV_FILE="${HOME}/.config/playwright-cli/env"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

configured_brave_executable="${PLAYWRIGHT_MCP_EXECUTABLE_PATH:-/Applications/Brave Browser.app/Contents/MacOS/Brave Browser}"
brave_launcher="${HOME}/bin/playwright-brave-launcher"
export PLAYWRIGHT_BRAVE_EXECUTABLE="$configured_brave_executable"
export PLAYWRIGHT_MCP_EXECUTABLE_PATH="$brave_launcher"

# Keep backend selection explicit. This wrapper deliberately implements only
# the local Brave adapter; other backends must have their own guarded adapter.
: "${DAVAFONS_BROWSER_BACKEND:=brave-extension}"
if [[ "$DAVAFONS_BROWSER_BACKEND" != "brave-extension" ]]; then
  echo "playwright-cli: backend '$DAVAFONS_BROWSER_BACKEND' is not supported by the Brave adapter" >&2
  exit 64
fi
export DAVAFONS_BROWSER_BACKEND

CLI_PACKAGE="${PLAYWRIGHT_CLI_PACKAGE:-@playwright/cli@0.1.21}"
CONTROL_DIR="${PLAYWRIGHT_CLI_CONTROL_DIR:-${HOME}/.local/state/playwright-cli/control}"
mkdir -p "$CONTROL_DIR"

set_controller_identity() {
  if [[ -n "${PLAYWRIGHT_CLI_SESSION:-}" ]]; then
    controller_suffix="${PLAYWRIGHT_CLI_SESSION//[^[:alnum:]_-]/-}"
    controller_label="Agent ${controller_suffix:0:12}"
    session_name="$controller_suffix"
    return
  fi

  if [[ -n "${CODEX_SESSION_ID:-}" ]]; then
    controller_suffix="${CODEX_SESSION_ID//[^[:alnum:]_-]/-}"
    controller_label="Codex ${controller_suffix:0:8}"
    session_name="codex-${controller_suffix}"
    return
  fi

  echo "playwright-cli: non-Codex controllers must set PLAYWRIGHT_CLI_SESSION" >&2
  return 64
}

activity_slug="${activity_option:-${PLAYWRIGHT_BROWSER_ACTIVITY:-main}}"
if [[ ! "$activity_slug" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]]; then
  echo "playwright-cli: activity must be a unique lowercase slug (1-40 letters, digits, or hyphens)" >&2
  exit 64
fi

session_name=""
controller_label=""
set_controller_identity
if [[ "$activity_slug" != "main" ]]; then
  session_name="${session_name}--${activity_slug}"
fi
owned_session_name="$session_name"
export DAVAFONS_BROWSER_GROUP_NAME="${controller_label} · ${activity_slug}"

redact_output() {
  sed -E 's/([?&]token=)[^&[:space:])]+/\1<redacted>/g'
}

cli() {
  # Playwright includes the current workspace in its daemon identity. Run the
  # control plane from one neutral directory so the same controller does not
  # create a second tab group merely because a command came from another repo.
  mkdir -p "$CONTROL_DIR/locks"
  # Serialize only this controller/activity. Different agents and activities
  # use different lock files and continue in parallel.
  (cd "$CONTROL_DIR" && lockf -t 10 "$CONTROL_DIR/locks/${owned_session_name}.lock" npx --yes "$CLI_PACKAGE" "$@")
}

run_cli() {
  cli "$@" \
    > >(redact_output) \
    2> >(redact_output >&2)
}

require_foreground() {
  if [[ "$allow_foreground" != "1" ]]; then
    echo "playwright-cli: '${command_name}' may take desktop focus; background mode refused it." >&2
    echo "After explicit foreground permission, use: playwright-cli --allow-foreground <command> ..." >&2
    exit 75
  fi
}

if [[ -z "${PLAYWRIGHT_MCP_EXTENSION_TOKEN:-}" ]]; then
  echo "playwright-cli: missing PLAYWRIGHT_MCP_EXTENSION_TOKEN" >&2
  echo "Copy it from the Playwright Extension status page into ${ENV_FILE}" >&2
  exit 1
fi

if [[ "${1:-}" == "doctor" ]]; then
  if [[ ! -x "$configured_brave_executable" ]]; then
    echo "playwright-cli: Brave executable is missing: $configured_brave_executable" >&2
    exit 1
  fi
  if [[ ! -x "$brave_launcher" ]]; then
    echo "playwright-cli: managed Brave launcher is missing: $brave_launcher" >&2
    exit 1
  fi

  env_mode="$(stat -f '%Lp' "$ENV_FILE" 2>/dev/null || true)"
  if [[ "$env_mode" != "600" ]]; then
    echo "playwright-cli: warning: $ENV_FILE permissions are ${env_mode:-unknown}; expected 600" >&2
  fi

  brave_data_dir="${HOME}/Library/Application Support/BraveSoftware/Brave-Browser"
  extension_manifest="$(find "$brave_data_dir" -maxdepth 6 -path '*/Extensions/mmlmfjhmonkocbjadbfplnigmagldckm/*/manifest.json' -print -quit 2>/dev/null || true)"
  if [[ -z "$extension_manifest" ]]; then
    echo "playwright-cli: Playwright Extension was not found in the Brave profile" >&2
    exit 1
  fi

  echo "playwright-cli: Brave executable: ok"
  echo "playwright-cli: group: ${DAVAFONS_BROWSER_GROUP_NAME}"
  echo "playwright-cli: browser backend: ${DAVAFONS_BROWSER_BACKEND}"
  echo "playwright-cli: extension token: configured (redacted)"
  echo "playwright-cli: Playwright Extension: installed"
  echo "playwright-cli: CLI version: $(cli --version)"
  doctor_session="$session_name"
  session_list="$(cli list --json | jq --arg name "$doctor_session" '{browsers: [.browsers[]? | select(.name == $name)]}')"
  printf '%s\n' "$session_list" | redact_output
  if printf '%s\n' "$session_list" \
    | jq -e --arg name "$doctor_session" \
      '.browsers[]? | select(.name == $name and .status == "open" and .attached == true)' \
      >/dev/null; then
    run_cli "-s=${doctor_session}" tab-list
  else
    echo "playwright-cli: no attached '${doctor_session}' session; run attach --extension when ready"
  fi
  exit 0
fi

args=()
expect_session_name=0
explicit_session_name=0
extension_attach=0
attach_command=0
command_name=""
help_requested=0
for a in "$@"; do
  if [[ "$expect_session_name" == "1" ]]; then
    session_name="$a"
    expect_session_name=0
  elif [[ "$a" == "-s" || "$a" == "--session" ]]; then
    expect_session_name=1
    explicit_session_name=1
  elif [[ "$a" == -s=* ]]; then
    session_name="${a#-s=}"
    explicit_session_name=1
  elif [[ "$a" == --session=* ]]; then
    session_name="${a#--session=}"
    explicit_session_name=1
  elif [[ -z "$command_name" && "$a" != -* ]]; then
    command_name="$a"
  fi

  if [[ "$command_name" == "attach" && ( "$a" == "--extension" || "$a" == --extension=* ) ]]; then
    extension_attach=1
  fi
  if [[ "$a" == "--help" || "$a" == "-h" ]]; then
    help_requested=1
  fi

  if [[ "$a" == "--extension" ]]; then
    args+=("--extension=chrome")
  else
    args+=("$a")
  fi
done
if [[ "$command_name" == "attach" ]]; then
  attach_command=1
fi

if [[ "$explicit_session_name" == "1" && "$session_name" != "$owned_session_name" ]]; then
  echo "playwright-cli: refusing another controller's session" >&2
  exit 64
fi

if [[ "$attach_command" == "1" && "$extension_attach" != "1" && "$help_requested" == "0" ]]; then
  echo "playwright-cli: only 'attach --extension' is supported" >&2
  exit 64
fi

for a in "${args[@]}"; do
  case "$a" in
    --cdp|--cdp=*|--endpoint|--endpoint=*)
      echo "playwright-cli: raw CDP and endpoint connections are disabled" >&2
      exit 64
      ;;
  esac
done

# A new extension attach creates a visible handshake/Welcome tab. If the
# configured session is already live, keep using it instead of reattaching.
# This performs a read-only tab check and never closes browser tabs.
if [[ "$attach_command" == "1" && "$extension_attach" == "1" && "$help_requested" == "0" ]]; then
  if cli list --json 2>/dev/null | jq -e --arg name "$session_name" \
      '.browsers[]? | select(.name == $name and .status == "open" and .attached == true)' >/dev/null \
      && existing_tabs="$(cli "-s=${session_name}" tab-list --raw 2>/dev/null)" \
      && [[ -n "$existing_tabs" ]]; then
    target_tabs="$(printf '%s\n' "$existing_tabs" | sed '/chrome-extension:\/\/mmlmfjhmonkocbjadbfplnigmagldckm\/connect\.html/d' | sed '/^[[:space:]]*$/d')"
    if [[ -n "$target_tabs" ]]; then
      echo "playwright-cli: reusing attached Brave group '${session_name}'"
    else
      echo "playwright-cli: reusing attached Brave group '${session_name}' (Welcome tab only)"
      echo "playwright-cli: tab-new requires explicit foreground permission"
    fi
    exit 0
  fi
fi

if [[ "$help_requested" == "0" ]]; then
  case "$command_name" in
    close|close-all|kill-all|tab-close)
      echo "playwright-cli: browser-closing commands are disabled" >&2
      exit 64
      ;;
    open)
      echo "playwright-cli: launching another browser is disabled; use the attached Brave session" >&2
      exit 64
      ;;
    attach|tab-new|tab-select|recording-start|show) require_foreground ;;
  esac
fi

# `list` is required to verify an attachment, but the underlying global command
# must not disclose other agents' session names or tabs.
if [[ "$command_name" == "list" && "$help_requested" == "0" ]]; then
  cli list --json | jq --arg name "$owned_session_name" '{browsers: [.browsers[]? | select(.name == $name)]}' | redact_output
  exit 0
fi

if [[ "$attach_command" == "1" && "$explicit_session_name" == "0" ]]; then
  run_cli "${args[@]}" "--session=${session_name}"
elif [[ "$explicit_session_name" == "1" ]]; then
  run_cli "${args[@]}"
else
  run_cli "-s=${session_name}" "${args[@]}"
fi
