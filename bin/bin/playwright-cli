#!/usr/bin/env bash
# Drive Brave Beta through the Playwright Extension: one background tab group
# per agent activity, never a new browser. Token and Brave path live in
# ~/.config/playwright-cli/env.
set -euo pipefail

activity_slug="${PLAYWRIGHT_BROWSER_ACTIVITY:-main}"
case "${1:-}" in
  --activity=*) activity_slug="${1#--activity=}"; shift ;;
  --activity)
    [[ $# -ge 2 ]] || { echo "playwright-cli: --activity requires a name" >&2; exit 64; }
    activity_slug="$2"; shift 2 ;;
esac
if [[ ! "$activity_slug" =~ ^[a-z0-9][a-z0-9-]{0,39}$ ]]; then
  echo "playwright-cli: activity must be a unique lowercase slug (1-40 letters, digits, or hyphens)" >&2
  exit 64
fi

ENV_FILE="${HOME}/.config/playwright-cli/env"
if [[ -f "$ENV_FILE" ]]; then
  set -a
  # shellcheck disable=SC1090
  source "$ENV_FILE"
  set +a
fi

: "${DAVAFONS_BROWSER_BACKEND:=brave-extension}"
if [[ "$DAVAFONS_BROWSER_BACKEND" != "brave-extension" ]]; then
  echo "playwright-cli: backend '$DAVAFONS_BROWSER_BACKEND' is not supported by the Brave adapter" >&2
  exit 64
fi
if [[ -z "${PLAYWRIGHT_MCP_EXTENSION_TOKEN:-}" ]]; then
  echo "playwright-cli: missing PLAYWRIGHT_MCP_EXTENSION_TOKEN; copy it from the Playwright Extension status page into ${ENV_FILE}" >&2
  exit 1
fi
brave_executable="${PLAYWRIGHT_MCP_EXECUTABLE_PATH:-/Applications/Brave Browser Beta.app/Contents/MacOS/Brave Browser Beta}"
export PLAYWRIGHT_MCP_EXECUTABLE_PATH="$brave_executable" PLAYWRIGHT_MCP_BACKGROUND=1

if [[ -n "${PLAYWRIGHT_CLI_SESSION:-}" ]]; then
  session_name="${PLAYWRIGHT_CLI_SESSION//[^[:alnum:]_-]/-}"
elif [[ -n "${CODEX_SESSION_ID:-}" ]]; then
  session_name="codex-${CODEX_SESSION_ID//[^[:alnum:]_-]/-}"
elif [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
  session_name="claude-${CLAUDE_CODE_SESSION_ID:0:8}"
else
  echo "playwright-cli: set PLAYWRIGHT_CLI_SESSION to a name unique to this agent session" >&2
  exit 64
fi
[[ "$activity_slug" == "main" ]] || session_name="${session_name}--${activity_slug}"

CONTROL_DIR="${PLAYWRIGHT_CLI_CONTROL_DIR:-${HOME}/.local/state/playwright-cli/control}/background"
mkdir -p "$CONTROL_DIR/locks"

# One command per session at a time, so parallel first calls share one attach.
if [[ "${PLAYWRIGHT_CLI_LOCK_HELD:-}" != "$session_name" ]]; then
  exec lockf -k -t 10 "$CONTROL_DIR/locks/${session_name}.lock" \
    env PLAYWRIGHT_CLI_LOCK_HELD="$session_name" PLAYWRIGHT_BROWSER_ACTIVITY="$activity_slug" \
    /bin/bash "$0" "$@"
fi
unset PLAYWRIGHT_CLI_LOCK_HELD

CLI_VERSION="${PLAYWRIGHT_CLI_VERSION:-1.66.0-alpha-2026-11-17}"
CLI_ROOT="${XDG_DATA_HOME:-${HOME}/.local/share}/playwright-cli/${CLI_VERSION}"

# Extension mode connects with noDefaults, which skips focus emulation: an
# inactive agent tab stays hidden, gets no animation frames, and clicks stall on
# the stability check. Patch it back on until upstream ships the fix
# (microsoft/playwright#44096, PR #44101). The anchor must match exactly once,
# so a version that moved the code fails here instead of losing background input.
install_cli() {
  [[ -f "$CLI_ROOT/.focus-patched" ]] && return 0
  local staging
  mkdir -p "${CLI_ROOT%/*}"
  staging="$(mktemp -d "${CLI_ROOT%/*}/.install.XXXXXX")"
  npm install --silent --no-audit --no-fund --prefix "$staging" "playwright-core@${CLI_VERSION}" >&2
  node - "$staging/node_modules/playwright-core/lib/coreBundle.js" <<'NODE'
const fs = require('fs');
const file = process.argv[2];
const source = fs.readFileSync(file, 'utf8');
const anchor = 'if (this._isMainFrame() && !skipDefaultOverrides)\n            promises2.push(this._client.send("Emulation.setFocusEmulationEnabled"';
const count = source.split(anchor).length - 1;
if (count !== 1) {
  console.error(`playwright-cli: focus-emulation patch matched ${count} times; drop it if PR #44101 shipped, otherwise re-verify background tabs`);
  process.exit(1);
}
fs.writeFileSync(file, source.replace(anchor, anchor.replace('!skipDefaultOverrides', '(!skipDefaultOverrides || process.env.PLAYWRIGHT_MCP_BACKGROUND)')));
NODE
  touch "$staging/.focus-patched"
  rm -rf "$CLI_ROOT"
  mv "$staging" "$CLI_ROOT"
}

cli() {
  install_cli
  # Playwright keys its daemon on the working directory; one neutral directory
  # keeps a controller's group the same whichever repo the command came from.
  (cd "$CONTROL_DIR" && node "$CLI_ROOT/node_modules/playwright-core/cli.js" cli "$@")
}

# `list` is global; show only this session so agents never see each other's tabs.
own_sessions() {
  cli list --json | jq --arg name "$session_name" '{browsers: [.browsers[]? | select(.name == $name)]}'
}

attached() {
  own_sessions | jq -e '.browsers[] | select(.status == "open" and .attached == true)' >/dev/null
}

verify_attached() {
  local tabs
  own_sessions | jq -e '.browsers[] | select(.status == "open" and .attached == true and .browserType == "chrome")' >/dev/null \
    || { echo "playwright-cli: attachment verification failed for '${session_name}'" >&2; return 1; }
  tabs="$(cli "-s=${session_name}" tab-list --raw)"
  [[ -n "${tabs//[[:space:]]/}" ]] || { echo "playwright-cli: attached session '${session_name}' has no tabs" >&2; return 1; }
  echo "playwright-cli: verified Brave group '${session_name}'"
  printf '%s\n' "$tabs"
}

if [[ "${1:-}" == "doctor" ]]; then
  [[ -x "$brave_executable" ]] || { echo "playwright-cli: Brave is missing: $brave_executable" >&2; exit 1; }
  profile="Brave-Browser"
  [[ "$brave_executable" == *"Brave Browser Beta"* ]] && profile="Brave-Browser-Beta"
  if ! compgen -G "${HOME}/Library/Application Support/BraveSoftware/${profile}/*/Extensions/mmlmfjhmonkocbjadbfplnigmagldckm/*/manifest.json" >/dev/null; then
    echo "playwright-cli: Playwright Extension is not installed in ${profile}" >&2
    exit 1
  fi
  [[ "$(stat -f '%Lp' "$ENV_FILE" 2>/dev/null)" == "600" ]] || echo "playwright-cli: warning: $ENV_FILE should be mode 600" >&2
  echo "playwright-cli: ${profile}, extension installed, token configured"
  echo "playwright-cli: CLI $(cli --version), focus emulation patched, background mode"
  if attached; then cli "-s=${session_name}" tab-list; else echo "playwright-cli: '${session_name}' not attached; run attach --extension"; fi
  exit 0
fi

command_name=""
args=()
for a in "$@"; do
  case "$a" in
    -s=*|--session=*)
      if [[ "${a#*=}" != "$session_name" ]]; then
        echo "playwright-cli: refusing another controller's session" >&2
        exit 64
      fi
      continue ;;
    -s|--session)
      echo "playwright-cli: use --activity instead of a session name" >&2
      exit 64 ;;
    --cdp|--cdp=*|--endpoint|--endpoint=*)
      echo "playwright-cli: raw CDP and endpoint connections are disabled" >&2
      exit 64 ;;
    --extension) a="--extension=chrome" ;;
  esac
  if [[ -z "$command_name" ]]; then
    case "$a" in
      --help|-h|--version|--json|--raw) ;;
      -*) echo "playwright-cli: put the command before command-specific options" >&2; exit 64 ;;
      *) command_name="$a" ;;
    esac
  fi
  args+=("$a")
done

help=0
for a in "${args[@]}"; do [[ "$a" == "--help" || "$a" == "-h" ]] && help=1; done

if [[ "$help" == "0" ]]; then
  case "$command_name" in
    open) echo "playwright-cli: launching another browser is disabled; use attach --extension" >&2; exit 64 ;;
    close|close-all|kill-all|tab-close)
      echo "playwright-cli: browser-closing commands are disabled" >&2; exit 64 ;;
    list) own_sessions; exit ;;
    attach)
      [[ " ${args[*]} " == *" --extension=chrome "* ]] || { echo "playwright-cli: only 'attach --extension' is supported" >&2; exit 64; }
      # Re-attaching a live session opens a new connection tab and resets it.
      if attached; then
        echo "playwright-cli: reusing attached Brave group '${session_name}'"
        verify_attached
        exit
      fi
      # Snapshots and screenshots accumulate per command; keep a week of them.
      find "$CONTROL_DIR/.playwright-cli" -type f -mtime +7 -delete 2>/dev/null || true
      cli "${args[@]}" "--session=${session_name}"
      verify_attached
      exit ;;
  esac
fi

if [[ "$command_name" == "attach" ]]; then
  cli "${args[@]}" "--session=${session_name}"
else
  cli "-s=${session_name}" "${args[@]}"
fi
