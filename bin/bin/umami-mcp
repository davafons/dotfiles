#!/usr/bin/env bash
# Launch the official Umami MCP (read-only analytics tools) against LOST COORDS' Umami.
# The API key stays in the macOS Keychain, not in mcporter.json.
set -euo pipefail

keychain_service="com.davafons.codex.mcp-umami"
token="$(security find-generic-password -a "${USER}" -s "$keychain_service" -w 2>/dev/null)" || {
  echo "umami-mcp: missing Keychain item '$keychain_service'" >&2
  exit 1
}

export UMAMI_URL="${UMAMI_URL:-https://umami.lostcoords.com}"
export UMAMI_API_TOKEN="$token"
unset token
exec npx --yes @umami/mcp@0.2.0 "$@"
