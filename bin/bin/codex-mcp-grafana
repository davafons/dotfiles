#!/usr/bin/env bash
# Launch the Grafana MCP without storing its service-account token in Codex TOML.
set -euo pipefail

keychain_service="com.davafons.codex.mcp-grafana"
token="$(security find-generic-password -a "${USER}" -s "$keychain_service" -w 2>/dev/null)" || {
  echo "codex-mcp-grafana: missing Keychain item '$keychain_service'" >&2
  exit 1
}

export GRAFANA_SERVICE_ACCOUNT_TOKEN="$token"
unset token
exec uvx mcp-grafana "$@"
