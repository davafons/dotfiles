#!/usr/bin/env bash
# Keep provider-owned skills outside the dotfiles tree. Facade skills remain
# versioned under dotfiles/agents; HEY, Fizzy, and WariWari own their manuals.
set -euo pipefail

command_name="${1:-status}"
providers=(hey fizzy wariwari)
davstack_skills=(
  how why teach recall create-verification-skill
  dav-mode blast-radius comment-sicko no-comments reflect tdd unslop technical-writing deslop loop figure-it-out
)
personal_skills=(browser calendar mail notes plan tasks)
linked_skills=("${personal_skills[@]}" "${davstack_skills[@]}")
real_home="${HOME}"
skill_root="${real_home}/.agents/skills"
script_path="$(realpath "${BASH_SOURCE[0]}")"
dotfiles_root="$(cd "$(dirname "$script_path")/../.." && pwd)"

provider_version() {
  "$1" --version 2>/dev/null | head -n 1
}

status() {
  for provider in "${providers[@]}"; do
    if command -v "$provider" >/dev/null 2>&1; then
      printf '%-10s %s (%s)\n' "$provider" "$(provider_version "$provider")" "$(command -v "$provider")"
    else
      printf '%-10s missing\n' "$provider"
    fi
  done
}

skill_source() {
  local name="$1" group
  case " ${davstack_skills[*]} " in
    *" $name "*) group=davstack ;;
    *) group=personal ;;
  esac
  printf '%s/agents/.agents/%s/skills/%s\n' "$dotfiles_root" "$group" "$name"
}

migrate_owned_link() {
  local source="$1" destination="$2" legacy="$3"
  if [[ -L "$destination" && "$(readlink "$destination")" == "$legacy" ]]; then
    rm -- "$destination"
    ln -s "$source" "$destination"
    echo "agent-skills: migrated $destination"
  fi
}

link_skill() {
  local skill="$1" source destination item relative expected legacy
  source="$(skill_source "$skill")"
  legacy="${dotfiles_root}/agents/.agents/skills/${skill}"
  destination="${2:-${skill_root}/${skill}}"

  [[ -f "${source}/SKILL.md" ]] || {
    echo "agent-skills: missing skill source: ${source}/SKILL.md" >&2
    return 1
  }
  mkdir -p "$(dirname "$destination")"
  migrate_owned_link "$source" "$destination" "$legacy"

  if [[ -L "$destination" ]]; then
    if [[ "$(realpath "$destination")" == "$(realpath "$source")" ]]; then
      return
    fi
    echo "agent-skills: refusing to replace unrelated link: $destination" >&2
    return 1
  fi

  if [[ -e "$destination" ]]; then
    [[ -d "$destination" ]] || {
      echo "agent-skills: refusing to replace non-directory: $destination" >&2
      return 1
    }
    while IFS= read -r item; do
      if [[ ! -L "$item" ]]; then
        echo "agent-skills: refusing to replace unmanaged skill content: $item" >&2
        return 1
      fi
      relative="${item#"$destination"/}"
      expected="${source}/${relative}"
      if [[ "$(readlink "$item")" != "${legacy}/${relative}" &&
            "$(realpath "$item" 2>/dev/null)" != "$(realpath "$expected")" ]]; then
        echo "agent-skills: refusing to replace unrelated skill link: $item" >&2
        return 1
      fi
    done < <(find "$destination" -mindepth 1 ! -type d)
    rm -r -- "$destination"
  fi

  ln -s "$source" "$destination"
  echo "agent-skills: linked $destination"
}

link_agent() {
  local harness="$1" filename="$2" name="$3" package="$4" source destination
  source="$(skill_source "$package")/agents/${filename}"
  destination="${real_home}/.${harness}/agents/${name}.${filename##*.}"
  [[ -f "$source" ]] || { echo "agent-skills: missing agent source: $source" >&2; return 1; }
  if [[ "$harness" == claude && "$name" == comment-sicko ]]; then
    migrate_owned_link "$source" "$destination" "${dotfiles_root}/agents/.agents/skills/comment-sicko/agents/claude.md"
  fi
  if [[ -L "$destination" && "$(realpath "$destination")" == "$(realpath "$source")" ]]; then
    return
  fi
  if [[ -e "$destination" || -L "$destination" ]]; then
    echo "agent-skills: refusing to replace unmanaged agent: $destination" >&2
    return 1
  fi
  mkdir -p "$(dirname "$destination")"
  ln -s "$source" "$destination"
  echo "agent-skills: linked $destination"
}

link_skills() {
  local skill
  for skill in "${linked_skills[@]}"; do link_skill "$skill"; done
  for skill in "${davstack_skills[@]}"; do
    link_skill "$skill" "${real_home}/.claude/skills/${skill}"
  done
  link_agent claude claude.md comment-sicko comment-sicko
  link_agent codex codex.toml comment-sicko comment-sicko
  link_agent claude claude.md dav-agent dav-mode
  link_agent codex codex.toml dav-agent dav-mode
}

sync_provider() (
  local provider="$1" scratch source destination replacement previous
  command -v "$provider" >/dev/null 2>&1 || {
    echo "agent-skills: '$provider' is not installed" >&2
    return 1
  }

  scratch="$(mktemp -d "${TMPDIR:-/tmp}/agent-skills.${provider}.XXXXXX")"
  trap 'rm -rf "$scratch"' EXIT
  if ! HOME="$scratch" "$provider" skill install >/dev/null 2>"$scratch/install.err"; then
    cat "$scratch/install.err" >&2
    return 1
  fi
  source="${scratch}/.agents/skills/${provider}"
  destination="${skill_root}/${provider}"
  replacement="${skill_root}/.${provider}.new.$$"
  previous="${skill_root}/.${provider}.old.$$"

  if [[ ! -f "${source}/SKILL.md" ]]; then
    echo "agent-skills: '$provider skill install' did not produce ${source}/SKILL.md" >&2
    return 1
  fi

  mkdir -p "$skill_root"
  rm -rf "$replacement" "$previous"
  cp -R "$source" "$replacement"
  if [[ "$provider" == "hey" || "$provider" == "fizzy" ]]; then
    # Provider manuals remain explicitly available to facade skills without
    # competing with those facades for ordinary user requests.
    mkdir -p "$replacement/agents"
    printf 'policy:\n  allow_implicit_invocation: false\n' > "$replacement/agents/openai.yaml"
  fi
  if [[ -e "$destination" || -L "$destination" ]]; then
    mv "$destination" "$previous"
  fi
  mv "$replacement" "$destination"
  rm -rf "$previous"
  echo "agent-skills: refreshed $provider"
)

check() {
  local failed=0 provider name skill legacy resolved expected harness filename agent_skill
  for name in "${linked_skills[@]}"; do
    skill="${skill_root}/${name}"
    expected="$(skill_source "$name")"
    if [[ ! -L "$skill" ]]; then
      echo "agent-skills: skill must be a directory symlink: $skill (run make install)" >&2
      failed=1
    elif [[ "$(realpath "$skill")" != "$(realpath "$expected")" ]]; then
      echo "agent-skills: skill points to the wrong source: $skill" >&2
      failed=1
    fi
  done
  for name in "${davstack_skills[@]}"; do
    skill="${real_home}/.claude/skills/${name}"
    expected="$(skill_source "$name")"
    if [[ ! -L "$skill" ]]; then
      echo "agent-skills: missing Claude skill link: $skill (run agent-skills link)" >&2
      failed=1
    elif [[ "$(realpath "$skill")" != "$(realpath "$expected")" ]]; then
      echo "agent-skills: Claude skill points to the wrong source: $skill" >&2
      failed=1
    fi
  done
  for name in comment-sicko dav-agent; do
    case "$name" in
      comment-sicko) agent_skill=comment-sicko ;;
      dav-agent) agent_skill=dav-mode ;;
    esac
    for harness in Claude Codex; do
      case "$harness" in
        Claude) filename=claude.md; skill="${real_home}/.claude/agents/${name}.md" ;;
        Codex) filename=codex.toml; skill="${real_home}/.codex/agents/${name}.toml" ;;
      esac
      expected="$(skill_source "$agent_skill")/agents/${filename}"
      if [[ ! -L "$skill" ]] || [[ "$(realpath "$skill")" != "$(realpath "$expected")" ]]; then
        echo "agent-skills: missing or incorrect $harness agent link: $skill (run agent-skills link)" >&2
        failed=1
      fi
    done
  done
  for provider in "${providers[@]}"; do
    skill="${skill_root}/${provider}/SKILL.md"
    legacy="${real_home}/.codex/skills/${provider}/SKILL.md"
    if ! command -v "$provider" >/dev/null 2>&1; then
      echo "agent-skills: missing CLI: $provider" >&2
      failed=1
    elif [[ ! -f "$skill" ]]; then
      echo "agent-skills: missing provider skill: $skill (run make skills-sync)" >&2
      failed=1
    else
      resolved="$(realpath "$skill")"
      if [[ "$resolved" == "${dotfiles_root}/"* ]]; then
        echo "agent-skills: provider skill is accidentally stored in dotfiles: $provider" >&2
        failed=1
      fi
      if [[ "$provider" == "hey" || "$provider" == "fizzy" ]]; then
        if ! grep -q 'allow_implicit_invocation: false' "${skill_root}/${provider}/agents/openai.yaml" 2>/dev/null; then
          echo "agent-skills: provider adapter must be explicit-only: $provider" >&2
          failed=1
        fi
      fi
    fi
    if [[ -f "$legacy" ]]; then
      echo "agent-skills: duplicate legacy Codex skill: $legacy" >&2
      failed=1
    fi
  done
  return "$failed"
}

case "$command_name" in
  link) link_skills ;;
  sync)
    link_skills
    for provider in "${providers[@]}"; do sync_provider "$provider"; done
    ;;
  sync-providers)
    shift
    selected=("$@")
    if [[ ${#selected[@]} -eq 0 ]]; then selected=("${providers[@]}"); fi
    for provider in "${selected[@]}"; do
      case " ${providers[*]} " in
        *" ${provider} "*) ;;
        *) echo "agent-skills: unknown provider: $provider" >&2; exit 64 ;;
      esac
      sync_provider "$provider"
    done
    ;;
  check) check ;;
  status) status ;;
  *)
    echo "usage: agent-skills {link|sync|sync-providers [name...]|check|status}" >&2
    exit 64
    ;;
esac
