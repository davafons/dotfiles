**/.DS_Store
claude/.claude/*
!claude/.claude/commands/
!claude/.claude/statusline.sh
!claude/.claude/settings.json
!claude/.claude/CLAUDE.md

tmux/.config/tmux/plugins/

# Local environment variables (sensitive)
shell/.bashrc.d/*.local.sh
**/.gitconfig.local
jj-work/.config/jj/conf.d/*.toml
jj/.config/jj/repos/

# Local build output and editor logs
herdr/.config/herdr/local-plugins/*/target/
nvim/nvim.log
nvim/.ruby-lsp/

# Local credentials and provider state
**/.env
**/.env.*
!**/.env.example
**/*.key
**/config.local.yaml
**/config.local.toml
# Generated by yuke-rust/scripts/setup-state.py with an absolute SDK path
yuke-rust/.config/yuke-rust/tsconfig.json
gh/.config/gh/hosts.yml
**/.ssh/id_*

# Generated caches, temporary files, and local databases
**/__pycache__/
*.py[cod]
*.tmp
*.db
*.sqlite
*.sqlite3

# Bun installs davstack script dependencies on first use.
agents/.agents/davstack/**/node_modules/
