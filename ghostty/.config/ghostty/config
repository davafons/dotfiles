command = /bin/bash -l

font-family = HackGen Console NF
font-size = 15
adjust-cell-height = 10%

# https://github.com/jan-warchol/selenized
theme = Selenized Dark
# Darken reading and selection surfaces without changing the text palette.
background = #082b34
cursor-text = #082b34
selection-background = #0d303a

# Keep reading contrast independent of the wallpaper.
background-opacity = 1
window-decoration = false
window-padding-x = 5
window-padding-y = 5

# Preserve Shift+Enter as a modified Enter key for terminal applications.
keybind = shift+enter=csi:13;2u
