+fn strip_agent_badge(label: &str) -> &str {
+    static MARKER: std::sync::OnceLock<regex::Regex> = std::sync::OnceLock::new();
+    let marker = MARKER.get_or_init(|| regex::Regex::new(r"^(?:\[[1-9]\d*(?:,[1-9]\d*)* [●×◐✓○·]\]|\[[1-9]\d*(?:,[1-9]\d*)*\] [●×◐✓○·]|[●×◐✓○·]\[[1-9]\d*(?:,[1-9]\d*)*\])\s+").unwrap());
+    marker
+        .find(label)
+        .map_or(label, |found| &label[found.end()..])
+}
+
+fn color_agent_badge(
+    buffer: &mut Buffer,
+    rect: Rect,
+    text: &str,
+    status: crate::api::schema::AgentStatus,
+    palette: &Palette,
+) {
+    let label = text.trim_start();
+    if strip_agent_badge(label) == label {
+        return;
+    }
+    let mut x = rect.x + (text.len() - label.len()) as u16;
+    for ch in label.chars() {
+        if x >= rect.right() {
+            break;
+        }
+        let color = match ch {
+            '[' | ']' => Some(palette.overlay0),
+            '●' | '×' | '◐' | '✓' | '○' | '·' => Some(status_color(status, palette)),
+            '0'..='9' | ',' => Some(palette.text),
+            _ => None,
+        };
+        if let Some(color) = color {
+            buffer[(x, rect.y)].set_fg(color);
+        }
+        if ch == ']' {
+            break;
+        }
+        x += display_width(&ch.to_string());
+    }
+}
