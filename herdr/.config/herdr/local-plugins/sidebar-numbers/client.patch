+#[test]
+fn navigation_mode_uses_global_workspace_positions() {
+    let (mut state, remote_id) = numbered_state();
+    let mut remote = snapshot();
+    remote.boot_id = "remote-boot".into();
+    let mut second = remote.workspaces[0].clone();
+    second.workspace_id = "remote_ws_2".into();
+    second.label = "second remote workspace".into();
+    remote.workspaces.push(second);
+    state.set_endpoint_snapshot(&remote_id, Box::new(remote));
+    state.compose(120, 40).unwrap();
+    state.mode = ClientShellMode::Navigate;
+    let output = state.handle_raw_events(vec![RawInputEvent::Key(crate::input::TerminalKey::new(
+        KeyCode::Char('2'),
+        KeyModifiers::NONE,
+    ))]);
+    assert!(
+        matches!(&output.actions[..], [ClientShellAction::ActivateEndpoint { endpoint_id, target: Some(ClientEndpointFocusTarget::Workspace(workspace_id)) }] if endpoint_id == &remote_id && workspace_id == "remote_ws_2")
+    );
+}
