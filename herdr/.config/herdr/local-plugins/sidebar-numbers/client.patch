+use super::*;
+
+pub(super) fn shortcut_number(index: usize) -> String {
+    if index == 9 {
+        "0".into()
+    } else {
+        (index + 1).to_string()
+    }
+}
+
+pub(super) fn set_number(tokens: &mut HashMap<String, String>, index: Option<usize>) {
+    tokens.remove("shortcut_number");
+    if let Some(index) = index {
+        tokens.insert("shortcut_number".into(), shortcut_number(index));
+    }
+}
+
+pub(super) fn workspace_targets(
+    endpoints: &[ClientShellEndpoint],
+    local_groups: &HashSet<String>,
+    remote_groups: &HashMap<ClientEndpointId, HashSet<String>>,
+) -> Vec<(ClientEndpointId, String)> {
+    let empty = HashSet::new();
+    endpoints
+        .iter()
+        .filter(|endpoint| endpoint.status == ClientEndpointStatus::Online)
+        .flat_map(|endpoint| {
+            let groups = if endpoint.endpoint_id.is_local() {
+                local_groups
+            } else {
+                remote_groups.get(&endpoint.endpoint_id).unwrap_or(&empty)
+            };
+            endpoint
+                .snapshot
+                .as_deref()
+                .map_or_else(Vec::new, |snapshot| {
+                    render::workspace_entries(snapshot, groups)
+                        .into_iter()
+                        .map(|entry| {
+                            (
+                                endpoint.endpoint_id.clone(),
+                                snapshot.workspaces[entry.index].workspace_id.clone(),
+                            )
+                        })
+                        .collect()
+                })
+        })
+        .collect()
+}
+
+pub(super) fn plugin_action(
+    command: &crate::config::CustomCommandKeybind,
+) -> Option<crate::input::KeybindAction> {
+    use crate::input::KeybindAction;
+    if command.action != crate::config::CustomCommandAction::PluginAction {
+        return None;
+    }
+    let action = command.command.strip_prefix("sidebar-numbers.")?;
+    let (kind, number) = action.rsplit_once('-')?;
+    let number = number.parse::<usize>().ok()?;
+    if !(10..=20).contains(&number) {
+        return None;
+    }
+    match kind {
+        "agent" => Some(KeybindAction::FocusAgent(number - 1)),
+        "workspace" => Some(KeybindAction::SwitchWorkspace(number - 1)),
+        "tab" => Some(KeybindAction::SwitchTab(number - 1)),
+        _ => None,
+    }
+}
