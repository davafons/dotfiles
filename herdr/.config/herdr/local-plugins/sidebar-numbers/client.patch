+fn drag(state: &mut ClientShellState, source: &ClientEndpointId, target: &ClientEndpointId) {
+    let start = header(state, source);
+    let end = header(state, target);
+    assert!(mouse(state, MouseEventKind::Down(MouseButton::Left), start)
+        .actions
+        .is_empty());
+    assert!(mouse(state, MouseEventKind::Drag(MouseButton::Left), end)
+        .actions
+        .is_empty());
+    assert!(mouse(state, MouseEventKind::Up(MouseButton::Left), end)
+        .actions
+        .is_empty());
+}
