+use super::*;
+
+fn numbered_state() -> (ClientShellState, ClientEndpointId) {
+    let config: Config = toml::from_str(
+        r#"
+[ui]
+global_shortcuts = true
+machine_order = ["Build", "Local"]
+agent_panel_sort = "spaces"
+[ui.sidebar.spaces]
+rows = [["$shortcut_number", "workspace"]]
+[ui.sidebar.agents]
+rows = [["$shortcut_number", "agent"]]
+[[keys.command]]
+key = "prefix+ctrl+0"
+type = "plugin_action"
+command = "sidebar-numbers.agent-10"
+"#,
+    )
+    .unwrap();
+    let mut state = ClientShellState::new(ClientShellConfig::from_config(&config));
+    let profile = remote_profile();
+    let remote_id = ClientEndpointId::Ssh(profile.id.clone());
+    state.set_endpoint_catalog(&[profile]);
+    state.set_endpoint_status(&remote_id, ClientEndpointStatus::Online);
+    let mut local = snapshot();
+    local.agents = vec![agent(
+        "local agent",
+        crate::api::schema::AgentStatus::Idle,
+        1,
+    )];
+    local.agents[0].tokens = vec![("shortcut_number".into(), "99".into())];
+    state.set_snapshot(Box::new(local));
+    state.set_pane_surface(surface());
+    let mut remote = snapshot();
+    remote.boot_id = "remote-boot".into();
+    remote.workspaces[0].label = "remote-workspace".into();
+    remote.agents = vec![agent(
+        "remote agent",
+        crate::api::schema::AgentStatus::Idle,
+        1,
+    )];
+    state.set_endpoint_snapshot(&remote_id, Box::new(remote));
+    (state, remote_id)
+}
+
+#[test]
+fn global_numbers_follow_machine_order_and_shortcut_targets() {
+    let (mut state, remote_id) = numbered_state();
+    assert_eq!(state.endpoints[0].endpoint_id, remote_id);
+    let frame = state.compose(120, 40).unwrap();
+    let text = frame_text(&frame);
+    assert!(
+        text.lines()
+            .any(|line| line.contains("1") && line.contains("remote agent")),
+        "{text}"
+    );
+    assert!(
+        text.lines()
+            .any(|line| line.contains("2") && line.contains("local agent")),
+        "{text}"
+    );
+    assert!(
+        text.lines()
+            .any(|line| line.contains("1") && line.contains("remote-workspace")),
+        "{text}"
+    );
+    assert!(!text.contains("99"), "stale server numbering: {text}");
+    assert!(
+        text.lines().next().unwrap().contains("[2 ○]"),
+        "tab badge uses global number: {text}"
+    );
+    for action in [
+        crate::input::KeybindAction::FocusAgent(0),
+        crate::input::KeybindAction::SwitchWorkspace(0),
+    ] {
+        let mut output = ClientShellInput::default();
+        state.record_binding(crate::input::KeybindMatch::Action(action), &mut output);
+        assert!(
+            matches!(&output.actions[..], [ClientShellAction::ActivateEndpoint { endpoint_id, .. }] if endpoint_id == &remote_id)
+        );
+    }
+}
+
+#[test]
+fn offline_machine_does_not_consume_numbers() {
+    let (mut state, remote_id) = numbered_state();
+    state.set_endpoint_status(&remote_id, ClientEndpointStatus::Reconnecting);
+    let frame = state.compose(120, 40).unwrap();
+    let text = frame_text(&frame);
+    assert!(
+        text.lines()
+            .any(|line| line.contains("1") && line.contains("local agent")),
+        "{text}"
+    );
+    assert!(
+        text.lines()
+            .any(|line| line.contains("remote agent") && !line.contains("1")),
+        "{text}"
+    );
+}
+
+#[test]
+fn plugin_second_bank_uses_combined_list_without_remote_plugin() {
+    let (mut state, remote_id) = numbered_state();
+    let mut remote = snapshot();
+    remote.boot_id = "remote-boot".into();
+    remote.agents = (1..=12)
+        .map(|index| {
+            let mut item = agent(
+                &format!("remote {index}"),
+                crate::api::schema::AgentStatus::Idle,
+                1,
+            );
+            item.pane_id = format!("ws_1:p{index}");
+            item
+        })
+        .collect();
+    state.set_endpoint_snapshot(&remote_id, Box::new(remote));
+    let key = |code, modifiers| RawInputEvent::Key(crate::input::TerminalKey::new(code, modifiers));
+    state.handle_raw_events(vec![key(KeyCode::Char('b'), KeyModifiers::CONTROL)]);
+    let output = state.handle_raw_events(vec![key(KeyCode::Char('0'), KeyModifiers::CONTROL)]);
+    assert!(
+        matches!(&output.actions[..], [ClientShellAction::ActivateEndpoint { endpoint_id, target: Some(ClientEndpointFocusTarget::Pane(pane_id)) }] if endpoint_id == &remote_id && pane_id == "ws_1:p10")
+    );
+}
+
+fn frame_text(frame: &crate::protocol::FrameData) -> String {
+    frame
+        .cells
+        .chunks(frame.width as usize)
+        .map(|row| {
+            row.iter()
+                .map(|cell| cell.symbol.as_str())
+                .collect::<String>()
+        })
+        .collect::<Vec<_>>()
+        .join("\n")
+}
+
+#[test]
+fn numbers_follow_priority_sort_and_missing_positions_leave_focus_alone() {
+    let (mut state, remote_id) = numbered_state();
+    state.config.agent_panel_sort = crate::config::AgentPanelSortConfig::Priority;
+    let mut local = snapshot();
+    local.agents = vec![agent(
+        "local agent",
+        crate::api::schema::AgentStatus::Blocked,
+        2,
+    )];
+    state.set_snapshot(Box::new(local));
+    let text = frame_text(&state.compose(120, 40).unwrap());
+    assert!(
+        text.lines()
+            .any(|line| line.contains("1") && line.contains("local agent")),
+        "{text}"
+    );
+    assert!(
+        text.lines()
+            .any(|line| line.contains("2") && line.contains("remote agent")),
+        "{text}"
+    );
+    let targets = aggregate_navigation::online_agent_targets(
+        &state.endpoints,
+        &state.active_endpoint_id,
+        state.config.agent_panel_sort,
+    );
+    assert_eq!(targets[0].endpoint_id, ClientEndpointId::Local);
+    assert_eq!(targets[1].endpoint_id, remote_id);
+    for action in [
+        crate::input::KeybindAction::FocusAgent(19),
+        crate::input::KeybindAction::SwitchWorkspace(19),
+    ] {
+        let mut output = ClientShellInput::default();
+        state.record_binding(crate::input::KeybindMatch::Action(action), &mut output);
+        assert!(output.actions.is_empty());
+    }
+}
