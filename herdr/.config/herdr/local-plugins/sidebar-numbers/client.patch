+use super::*;
+
+impl ClientShellState {
+    pub(super) fn machine_drop_target_at(
+        &self,
+        source: &ClientEndpointId,
+        point: (u16, u16),
+    ) -> Option<MachineDropTarget> {
+        if !super::contains(self.hits.workspace_body, point)
+            || super::contains(self.hits.workspace_scrollbar, point)
+        {
+            return None;
+        }
+        let source_index = self
+            .endpoints
+            .iter()
+            .position(|endpoint| &endpoint.endpoint_id == source)?;
+        let hit = self
+            .hits
+            .machines
+            .iter()
+            .rev()
+            .find(|hit| hit.rect.y <= point.1)?;
+        let target_index = self
+            .endpoints
+            .iter()
+            .position(|endpoint| endpoint.endpoint_id == hit.endpoint_id)?;
+        if source_index == target_index {
+            return None;
+        }
+        if source_index > target_index {
+            return Some(MachineDropTarget {
+                before: Some(hit.endpoint_id.clone()),
+                row: hit.rect.y,
+            });
+        }
+        let next = self
+            .endpoints
+            .get(target_index + 1)
+            .map(|endpoint| endpoint.endpoint_id.clone());
+        let row = next
+            .as_ref()
+            .and_then(|id| self.hits.machines.iter().find(|hit| &hit.endpoint_id == id))
+            .map(|hit| hit.rect.y)
+            .unwrap_or_else(|| {
+                self.hits
+                    .workspaces
+                    .iter()
+                    .filter(|workspace| workspace.endpoint_id == hit.endpoint_id)
+                    .map(|workspace| workspace.rect.bottom())
+                    .max()
+                    .unwrap_or(hit.rect.bottom())
+            })
+            .min(self.hits.workspace_body.bottom().saturating_sub(1));
+        Some(MachineDropTarget { before: next, row })
+    }
+
+    pub(super) fn drag_machine_header(
+        &mut self,
+        point: (u16, u16),
+        outcome: &mut ClientShellInput,
+    ) {
+        let Some(ClientChromeDrag::Machine {
+            endpoint_id,
+            start,
+            dragged,
+            ..
+        }) = self.chrome_drag.as_ref()
+        else {
+            return;
+        };
+        let moved = *dragged || point.0.abs_diff(start.0).max(point.1.abs_diff(start.1)) >= 1;
+        let target = if moved {
+            self.machine_drop_target_at(endpoint_id, point)
+        } else {
+            None
+        };
+        if let Some(ClientChromeDrag::Machine {
+            dragged,
+            target: current,
+            ..
+        }) = self.chrome_drag.as_mut()
+        {
+            *dragged = moved;
+            *current = target;
+        }
+        outcome.repaint = true;
+    }
+
+    pub(super) fn finish_machine_header(
+        &mut self,
+        endpoint_id: ClientEndpointId,
+        dragged: bool,
+        point: (u16, u16),
+        outcome: &mut ClientShellInput,
+    ) {
+        if dragged {
+            if let Some(target) = self.machine_drop_target_at(&endpoint_id, point) {
+                self.reorder_machine(&endpoint_id, target.before.as_ref(), outcome);
+            }
+        } else if self.hits.machines.iter().any(|hit| {
+            hit.endpoint_id == endpoint_id
+                && super::contains(hit.rect, point)
+                && !super::contains(hit.collapse_toggle, point)
+        }) {
+            if endpoint_id == self.active_endpoint_id {
+                if !self.collapsed_endpoints.remove(&endpoint_id) {
+                    self.collapsed_endpoints.insert(endpoint_id.clone());
+                }
+                if endpoint_id.is_local() {
+                    self.activate_endpoint(endpoint_id, outcome);
+                }
+            } else if endpoint_id.is_local() || self.endpoint_is_online(&endpoint_id) {
+                outcome.actions.push(ClientShellAction::ActivateEndpoint {
+                    endpoint_id,
+                    target: None,
+                });
+            } else {
+                let label = self.endpoint_label(&endpoint_id).to_owned();
+                self.receive_endpoint_unavailable(format!("{label} is not ready"));
+            }
+        }
+        outcome.repaint = true;
+    }
+
+    fn reorder_machine(
+        &mut self,
+        source: &ClientEndpointId,
+        before: Option<&ClientEndpointId>,
+        outcome: &mut ClientShellInput,
+    ) {
+        let Some(source_index) = self
+            .endpoints
+            .iter()
+            .position(|endpoint| &endpoint.endpoint_id == source)
+        else {
+            return;
+        };
+        let target_index = if let Some(id) = before {
+            let Some(index) = self
+                .endpoints
+                .iter()
+                .position(|endpoint| &endpoint.endpoint_id == id)
+            else {
+                return;
+            };
+            index
+        } else {
+            self.endpoints.len()
+        };
+        let target_index = target_index - usize::from(source_index < target_index);
+        if source_index == target_index {
+            return;
+        }
+        let endpoint = self.endpoints.remove(source_index);
+        self.endpoints.insert(target_index, endpoint);
+        self.machine_order = self
+            .endpoints
+            .iter()
+            .map(|endpoint| endpoint.endpoint_id.storage_key())
+            .collect();
+        self.persist_chrome_preferences(outcome);
+    }
+}
