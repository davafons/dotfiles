# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

AddKeysToAgent yes

Host gh
  HostName github.com
  User git

# Prefer the fast LAN path when it is available; otherwise use Tailscale.
Match host qtower exec "nc -z -w 1 192.168.3.13 22 >/dev/null 2>&1"
  HostName 192.168.3.13
Match all

Host qtower
  HostName qtower
  User root

Host qtower-lan
  HostName 192.168.3.13
  User root

Host qtower-tailnet
  HostName qtower
  User root

Host watchtower
  Hostname watchtower
  User root

Host nadeshiko
  Hostname nadeshiko
  User root
  ProxyCommand tailscale nc %h %p

Host inari
  Hostname inari
  User root

Host monitoring
  Hostname monitoring
  User davafons

Host hokora
  Hostname hokora
  User root

Host taisha
  Hostname 100.75.117.10
  User davafons

Host silver
  Hostname silver
  User davafons

# Prefer TOWER's LAN address; use Tailscale when the LAN is unavailable.
Match originalhost tower exec "nc -z -w 1 192.168.3.249 22 >/dev/null 2>&1"
  HostName 192.168.3.249
Match all

Host tower
  HostName tower.tail5c9dbf.ts.net
  User davafons
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ConnectTimeout 8

Host tower-lan
  HostName 192.168.3.249
  User root
  IdentityFile ~/.ssh/id_ed25519
  IdentitiesOnly yes
  ConnectTimeout 8

Host tower-tailnet
  HostName tower.tail5c9dbf.ts.net
  User davafons
  ConnectTimeout 8
