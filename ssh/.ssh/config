# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

AddKeysToAgent yes

Host gh
  HostName github.com
  User git

# Prefer the fast LAN path when it is available; otherwise use Tailscale.
Match host qtower exec "nc -z -w 1 192.168.3.13 22 >/dev/null 2>&1"
  HostName 192.168.3.13
Match all

Host qtower
  HostName qtower
  User root

Host qtower-lan
  HostName 192.168.3.13
  User root

Host qtower-tailnet
  HostName qtower
  User root

Host watchtower
  Hostname watchtower
  User root

Host orange
  Hostname orange-1
  User ubuntu

Host nadeshiko
  Hostname nadeshiko
  User root

Host inari
  Hostname inari
  User root

Host monitoring
  Hostname monitoring
  User root

Host hokora
  Hostname hokora
  User root

Host tower-lan
  HostName 192.168.3.140
  User davafons
