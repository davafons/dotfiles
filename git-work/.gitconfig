[user]
  name = David Afonso

[include]
  path = ~/.gitconfig.local

[core]
  editor = nvim

[diff]
  tool = vimdiff

[push]
  default = current

[pull]
  rebase = true

[alias]
  a = add --all
  ai = add -i

  l = log
  s = status
  b = branch
  bd = branch -d
  c = checkout

  uns = reset HEAD

  d = diff
  dc = diff --cached

  ret = "!git add . & git cz --retry"

  co = comit
  coa = commit --amend

[commit]
	gpgsign = true

[gpg]
	program = gpg
